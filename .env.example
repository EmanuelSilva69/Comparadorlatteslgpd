# Copie para .env e ajuste. O .env NÃO deve ser versionado.

# Usuário de acesso ao sistema
APP_USUARIO=admin

# Hash da senha. Gere com: python tools/gerar_senha.py
# (alternativa apenas para testes locais: APP_SENHA=minha-senha)
APP_SENHA_HASH=

# Logins adicionais (equipe), no formato usuario|hash;usuario|hash
# Gere cada um com: python tools/gerar_senha.py --usuario mestrado --adicionar
APP_USUARIOS=

# Chave que assina o cookie de sessão. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# 1 = cookie só via HTTPS (recomendado em produção)
APP_COOKIE_SECURE=0

# Validade da sessão em horas
APP_SESSAO_HORAS=8

# 1 = permite disparar as rotas /api/update/* pelo navegador.
# Em produção, deixe 0 e rode a coleta como job separado.
APP_PERMITIR_ATUALIZACAO=0

# Pasta dos dados pessoais (fora do Git). Padrão: ./dados
# APP_DATA_DIR=/caminho/para/dados
